# KisanSetu — Production .gitignore (Render + Vercel)
# Dependencies
node_modules/
frontend/node_modules/
backend/.venv/
venv/
.venv/
env/
ENV/

# Environment & Secrets
.env
.env.local
.env.development.local
.env.production.local
frontend/.env
backend/.env
*.env
!.env.example
frontend/.env.example
!frontend/.env.example

# Build outputs
dist/
frontend/dist/
backend/dist/
build/
out/
.next/
.nuxt/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
*.whl

# OS & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel / Render
.vercel/
.render/
render.yaml.bak

# Coverage & Tests
coverage/
htmlcov/
.coverage
.nyc_output/

# Misc
*.tmp
*.temp
