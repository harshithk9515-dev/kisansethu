# KisanSetu Frontend — Environment Variables
# Copy this file to .env and fill values
# Vite exposes only VITE_ prefixed vars to the browser

# Backend URL — Render/Railway deployment (no trailing slash, no /api)
# Example: https://kisansetu-backend.onrender.com
# If left empty, the app uses relative /api/v1 which
#  - in production: is proxied via vercel.json rewrites → Render
#  - in development: is proxied via vite.config.js → http://127.0.0.1:8000
VITE_BACKEND_URL=https://kisansetu-backend.onrender.com

# Optional: override for local dev (uncomment to force direct backend)
# VITE_BACKEND_URL=http://127.0.0.1:8000

# To use Vercel preview deployments, set BACKEND_URL to your Render URL in Vercel dashboard:
# Vercel → Project → Settings → Environment Variables → VITE_BACKEND_URL
